+// The seed for r0 of every Xenos vertex shader.
+//
+// ORDINARY DRAWS (g_TessGrid == 0): r0.x is the auto-loaded vertex index and
+// r0.yzw are zero — bit-identical to what this used to be inline.
+//
+// PATCH DRAWS (Xenos prim 0x11 triangle patch / 0x12 quad patch): Xenos does not
+// feed a vertex index at all. It feeds a point in the patch DOMAIN, and the
+// shader is a domain shader in all but name. Fable2's four landscape patch
+// vertex shaders read r0.x as a patch index (biased by c113), r0.yz as that
+// domain point, and r1.x as a 4-way patch orientation code — read off their own
+// disassembly, and consistent across both shader families.
+//
+// With no domain point every terrain vertex gets u = v = 0, collapses onto one
+// patch corner, and the draw writes nothing: measured at 0 % depth coverage
+// against 27 % once a domain is supplied, same draw stream and same render state
+// (docs/world-era-fatal-and-selector.md §3d-viii, §3e, §3f).
+//
+// There is no tessellator here and deliberately none added: the runtime expands
+// each patch host-side into a g_TessGrid x g_TessGrid grid of quads (6 vertices
+// per cell) and publishes the grid size. Everything below is then arithmetic on
+// the vertex index — no vertex buffer and no index buffer, which is what these
+// shaders already expect, since they declare no vertex inputs at all and the
+// guest's "index" buffer for such a draw holds tessellation FACTORS.
+float4 XeVertexSeed(uint vertexId)
+{
+    uint grid = g_TessGrid;
+    if (grid == 0)
+        return float4(vertexId, 0.0, 0.0, 0.0);
+
+    uint vpp    = 6u * grid * grid;   // vertices per patch
+    uint patch  = vertexId / vpp;
+    uint cell   = (vertexId % vpp) / 6u;
+    uint corner = vertexId % 6u;
+    // Two triangles per cell: (0,0) (1,0) (0,1) and (1,0) (1,1) (0,1).
+    float2 c = float2((corner == 1u || corner == 3u || corner == 4u) ? 1.0 : 0.0,
+                      (corner == 2u || corner == 4u || corner == 5u) ? 1.0 : 0.0);
+    float2 uv = (float2(float(cell % grid), float(cell / grid)) + c) / float(grid);
+    return float4(float(patch), uv.x, uv.y, 0.0);
+}
